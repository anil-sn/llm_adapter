# LLM Adapter Environment Configuration
# Copy this file to .env and customize for your environment

# Model Configuration
# Specify which config file to use (relative to project root)
LLM_CONFIG=config/config-qwen36-27b.yaml

# API Configuration
API_HOST=0.0.0.0
API_PORT=8888

# vLLM Configuration
VLLM_PORT=8000
VLLM_HOST=localhost

# GPU Configuration
CUDA_VISIBLE_DEVICES=0,1,2,3  # Use all 4 GPUs
VLLM_TENSOR_PARALLEL_SIZE=4   # Match number of GPUs

# Performance Tuning
VLLM_GPU_MEMORY_UTILIZATION=0.85  # 85% GPU memory usage
VLLM_MAX_MODEL_LEN=1048576         # 1M context (for Qwen with YaRN)
VLLM_MAX_NUM_SEQS=2                # Concurrent requests

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/llm_adapter.log

# HuggingFace
HF_HOME=~/.cache/huggingface
HF_HUB_ENABLE_HF_TRANSFER=1  # Fast downloads

# Optional: HuggingFace Token (for gated models)
# HF_TOKEN=your_token_here
